{
    "name": "ketapay-woocommerce",
    "private": true,
    "description": "Dev tooling only: a WordPress + WooCommerce test site in Docker for the integration tests",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/ketapay-woocommerce vendor/bin/phpunit -c phpunit.integration.xml.dist"
    },
    "devDependencies": {
        "@wordpress/env": "12.0.0"
    },
    "overrides": {
        "qs": "^6.16.0"
    }
}
